# Ollama 서버 (기본값이면 생략 가능)
OLLAMA_BASE_URL=http://localhost:11434

# 서술 생성 모델 — 역할별로 따로 안 정했을 때의 공통 기본값
OLLAMA_GENERATION_MODEL=gemma4:12b-it-qat

# RAG 임베딩 (rag/ingest_*.py)
RAG_EMBED_MODEL=bge-m3

# 선택 — 역할별 모델·온도 오버라이드 (미설정 시 위 공통 모델 + 기본 온도)
# LLM_WORKER_MODEL=gemma4:12b-it-qat
# LLM_WORKER_TEMP=0.4
# LLM_EDIT_MODEL=gemma4:12b-it-qat
# LLM_EDIT_TEMP=0.2
# LLM_VERIFY_MODEL=gemma4:12b-it-qat
# LLM_VERIFY_TEMP=0.0

# 선택 — Ollama 생성 옵션 (llm/llm_model.py 주석에 각 값의 배경 설명)
# OLLAMA_NUM_CTX=16384        # 컨텍스트 길이. 낮추면 시스템 규칙이 잘려 규칙 위반이 샌다
# 출력 토큰 상한 — 역할마다 기본값이 다르다(worker/verify 768, edit 6144).
# edit은 6개 섹션 서술을 한 응답에 담으므로 작게 두면 편집 결과가 중간에 잘린다.
# LLM_EDIT_MAX_TOKENS=6144
# LLM_WORKER_MAX_TOKENS=768
# OLLAMA_REPEAT_PENALTY=1.1   # 미설정 시 꺼져서 JSON 생성 중 무한 반복이 발생한다
# OLLAMA_THINK=false          # thinking 모델의 사고 과정. true면 content가 비어 파싱 실패
